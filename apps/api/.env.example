# App
APP_PORT=4448
APP_PREFIX=api
APP_FRONTEND_URL=http://localhost:3000
APP_BACKEND_URL=http://localhost:4448
APP_TRUSTED_ORIGINS=*

# Database (choose one driver)
DB_DRIVER=postgres
DB_URL=

# Aurora Data API (alternative to postgres)
# DB_DRIVER=aurora-data-api
# DB_DATABASE=
# DB_SECRET_ARN=
# DB_RESOURCE_ARN=

# Email / SMTP
SMTP_URL=
SMTP_FROM_EMAIL=hello@akronrealty.co
SMTP_FROM_NAME=Akron Realty

# Redis
REDIS_URL=
REDIS_PORT=6379
REDIS_CACHE_TTL=3600

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4448/api/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
