# App
APP_PORT=3000
APP_PREFIX=api
APP_FRONTEND_URL=https://converge.emmanuelisenah.com
APP_BACKEND_URL=https://converge-api.emmanuelisenah.com
APP_TRUSTED_ORIGINS=https://converge.emmanuelisenah.com,https://converge-api.emmanuelisenah.com

# Database (choose one driver)
DB_DRIVER=postgres
DB_URL=

# Aurora Data API (alternative to postgres)
# DB_DRIVER=aurora-data-api
# DB_DATABASE=
# DB_SECRET_ARN=
# DB_RESOURCE_ARN=

# Email / SMTP
SMTP_URL=
SMTP_FROM_EMAIL=hello@converge.emmanuelisenah.com
SMTP_FROM_NAME=Converge

# Redis
REDIS_URL=
REDIS_CACHE_TTL=3600

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://converge-api.emmanuelisenah.com/api/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Postgres (for compose-based deploy)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Bull board
BULL_BOARD_PASSWORD=

# Mailpit access (for Caddy basic auth)
MAILPIT_BASIC_AUTH_USER=
MAILPIT_BASIC_AUTH_PASSWORD_HASH=
