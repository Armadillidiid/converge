{
  "name": "@repo/api",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "imports": {
    "#src/*": {
      "source": "./src/*",
      "default": "./dist/src/*"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --type-aware && nestjs-doctor",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "dev": "node --watch --import=@poppinss/ts-exec --conditions source ./src/main.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "node --watch --import=@poppinss/ts-exec --conditions source ./src/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/vitest --runInBand",
    "test:e2e": "vitest run --config ./test/vitest-e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "dx": "docker compose up -d || docker-compose up -d",
    "gen:openapi": "node --import=tsx --conditions source ./scripts/gen-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rds-data": "catalog:",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.17",
    "@orpc/contract": "^1.13.6",
    "@orpc/openapi": "^1.13.6",
    "@orpc/zod": "^1.13.6",
    "@repo/auth": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/lib": "workspace:*",
    "@scalar/nestjs-api-reference": "^1.1.3",
    "better-auth": "^1.5.2",
    "body-parser": "^2.2.2",
    "bullmq": "^5.70.0",
    "dotenv": "catalog:",
    "ioredis": "^5.9.3",
    "nodemailer": "^8.0.1",
    "reflect-metadata": "catalog:",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@poppinss/ts-exec": "^1.0.5",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "^1.10.7",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "catalog:",
    "globals": "^16.0.0",
    "nestjs-doctor": "^0.4.16",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.1",
    "vitest": "catalog:"
  }
}
