                    "roomId": {
                      "type": "string"
                    },
                    "inviterId": {
                      "type": "string"
                    },
                    "inviteeId": {
                      "type": "string"
                    },
                    "status": {
                      "enum": ["pending", "accepted", "declined"]
                    },
                    "expiresAt": {},
                    "createdAt": {}
                  },
                  "required": [
                    "id",
                    "roomId",
                    "inviterId",
                    "inviteeId",
                    "status"
                  ]
                }
              }
            }
          }
        }
