    "/ai/voice/speak": {
      "post": {
        "operationId": "ai.speak",
        "description": "Convert text to speech",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
