{
  "info": {
    "title": "Converge API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "openapi": "3.1.1",
  "components": {
    "schemas": {
      "ClientToServerEventName": {
        "enum": [
          "join_room",
          "leave_room",
          "send_message",
          "typing_start",
          "typing_stop",
          "heartbeat",
          "message:new",
          "user:typing",
          "user:presence",
          "member:joined",
          "member:left",
          "room:deleted"
        ]
      },
      "ServerToClientEventName": {
        "enum": [
          "join_room",
          "leave_room",
          "send_message",
          "typing_start",
          "typing_stop",
          "heartbeat",
          "message:new",
          "user:typing",
          "user:presence",
          "member:joined",
          "member:left",
          "room:deleted"
        ]
      },
      "wsJoinRoomInput": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string"
          }
        },
        "required": ["roomId"]
      },
      "wsLeaveRoomInput": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string"
          }
        },
        "required": ["roomId"]
      },
      "wsSendMessageInput": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        },
        "required": ["roomId", "content"]
      },
      "wsTypingInput": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string"
          }
        },
        "required": ["roomId"]
      },
      "wsMessageNewOutput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "roomId": {
            "type": "string"
          },
          "senderId": {
            "type": "string"
          },
          "senderName": {
            "type": "string"
          },
          "senderEmail": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "roomId",
          "senderId",
          "senderName",
          "senderEmail",
          "content",
          "createdAt"
        ]
      },
      "wsUserPresenceOutput": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "roomId": {
            "type": "string"
          },
          "status": {
            "enum": ["online", "offline"]
          }
        },
        "required": ["userId", "roomId", "status"]
      },
      "wsUserTypingOutput": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "roomId": {
            "type": "string"
          },
          "isTyping": {
            "type": "boolean"
          }
        },
        "required": ["userId", "roomId", "isTyping"]
      },
      "wsErrorOutput": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": ["message"]
      }
    }
  },
  "paths": {
    "/chat/rooms": {
      "post": {
        "operationId": "chat.createRoom",
        "description": "Create a new chat room",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "ownerId": {
                      "type": "string"
                    },
                    "createdAt": {},
                    "updatedAt": {}
                  },
                  "required": ["id", "name", "ownerId"]
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "chat.getRooms",
        "description": "List user's chat rooms (paginated)",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "ownerId": {
                            "type": "string"
                          },
                          "createdAt": {},
                          "updatedAt": {}
                        },
                        "required": ["id", "name", "ownerId"]
                      }
                    }
                  },
                  "required": ["items"]
                }
              }
            }
          }
        }
      }
    },
    "/chat/rooms/{id}": {
      "get": {
        "operationId": "chat.getRoom",
        "description": "Get room details with members",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "ownerId": {
                      "type": "string"
                    },
                    "createdAt": {},
                    "updatedAt": {},
                    "members": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "userId": {
                            "type": "string"
                          },
                          "role": {
                            "enum": ["owner", "member"]
                          },
                          "joinedAt": {},
                          "user": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "email": {
                                "type": "string"
                              }
                            },
                            "required": ["id", "name", "email"]
                          }
                        },
                        "required": ["id", "userId", "role", "user"]
                      }
                    }
                  },
                  "required": ["id", "name", "ownerId", "members"]
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "chat.deleteRoom",
        "description": "Delete room (owner only)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "required": ["success"]
                }
              }
            }
          }
        }
      }
    },
